APP_ENV=local
APP_NAME=internal-assistant-mvp

# Local database
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Local/runtime LLM configuration
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDINGS_PROVIDER=auto
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
LLM_TIMEOUT_SECONDS=120
# Claude en Microsoft Foundry: LLM_PROVIDER=anthropic_foundry, EMBEDDINGS_PROVIDER=openai,
# CHAT_MODEL=<nombre del deployment, p. ej. claude-haiku-5-5>
LLM_EFFORT=low
# Modelos desplegados en Foundry via su API compatible con OpenAI (p. ej. DeepSeek-V4-Flash
# y text-embedding-3-small en Data Zone EU): LLM_PROVIDER=azure_foundry, EMBEDDINGS_PROVIDER=azure_foundry,
# CHAT_MODEL/EMBEDDING_MODEL = nombres de los deployments.
AZURE_AI_RESOURCE=
AZURE_AI_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# Local service-to-service settings
ADMIN_API_KEY=change-this-admin-key
APP_SHARED_SECRET=change-this-shared-secret
APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGSMITH_TRACING=false
# Trazas extendidas por peticion (none | local | azure_blob). Ver docs/observability.md
TRACE_STORE=local
TRACE_STORE_DIR=traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=internal-assistant-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ALLOWED_ORIGINS=
BOT_ENDPOINT=
CUSTOM_INCIDENTS_API_BASE_URL=http://localhost:7071
INDEXER_API_BASE_URL=http://localhost:7072
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
TEAMS_APP_ID=
LOG_LEVEL=INFO
RETRIEVAL_CONFIDENCE_THRESHOLD=0.58
RERANKER_ENABLED=false
RERANKER_PROVIDER=http
RERANKER_BASE_URL=http://127.0.0.1:8091
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATES=100
# Para cambiar de reranker solo cambian estos valores (RERANKER_API_KEY es la clave del proveedor elegido):
#   Cohere en Foundry: RERANKER_PROVIDER=cohere_azure
#                      RERANKER_BASE_URL=https://<recurso>.services.ai.azure.com/providers/cohere/v2/rerank
#                      RERANKER_MODEL=Cohere-rerank-v4.0-fast
#   Voyage (Atlas UE): RERANKER_PROVIDER=voyage
#                      RERANKER_BASE_URL=https://eu.ai.mongodb.com
#                      RERANKER_MODEL=rerank-3-lite
# Presupuesto de tokens del contexto que se pasa al LLM (top 16 recortado hasta caber).
RETRIEVAL_CONTEXT_MAX_TOKENS=16000

# Local evaluation
EVAL_USE_LLM_JUDGE=false
EVAL_DATASET_PATH=evaluation/datasets/rag_eval_questions.json
EVAL_OUTPUT_DIR=evaluation/reports
EVAL_TOP_K=16
EVAL_VECTOR_WEIGHT=0.50
EVAL_TEXT_WEIGHT=0.50
EVAL_PROVIDER=mock
EVAL_MAX_CONCURRENCY=1
