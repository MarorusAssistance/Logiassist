APP_ENV=demo
APP_NAME=internal-assistant-mvp

# Azure infrastructure deployment
PROJECT_NAME=internal-assistant
ENVIRONMENT_NAME=demo
AZURE_LOCATION=westeurope
AZURE_RESOURCE_GROUP=rg-internal-assistant-demo
AZURE_FUNCTIONS_RESOURCE_GROUP=rg-internal-assistant-demo-functions
AZURE_SUBSCRIPTION_ID=
ENABLE_APPLICATION_INSIGHTS=true

# Azure Key Vault (secretos fuera de App Settings)
# true: deploy_infra crea Key Vault (RBAC) + identidades administradas y las App
# Settings secretas pasan a ser referencias @Microsoft.KeyVault(...).
# Flujo: deploy_infra -> sync_keyvault_secrets -> configure_app_settings -> check_keyvault_refs
USE_KEY_VAULT=true
# Vacio = se usa el nombre generado por Bicep (output keyVaultName, kv-<hash>).
KEY_VAULT_NAME=
# Vacio = se obtiene con `az ad signed-in-user show --query id -o tsv`.
# Si despliegas con un service principal, pon su object id y el tipo ServicePrincipal.
KEY_VAULT_ADMIN_PRINCIPAL_ID=
KEY_VAULT_ADMIN_PRINCIPAL_TYPE=User

# Azure PostgreSQL provisioning
POSTGRES_ADMIN_USER=pgadmininternal
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DATABASE_NAME=assistant

# Cloud runtime configuration
# Secretos que sync_keyvault_secrets.sh sube a Key Vault: DATABASE_URL (se construye
# desde POSTGRES_*), OPENAI_API_KEY, ADMIN_API_KEY, APP_SHARED_SECRET,
# MICROSOFT_APP_PASSWORD, RERANKER_API_KEY, LANGSMITH_API_KEY y POSTGRES_ADMIN_PASSWORD.
# Los valores vacios o placeholder (change-this-*, <...>) se omiten.
DATABASE_URL=
LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
LLM_TIMEOUT_SECONDS=120
RERANKER_ENABLED=false
RERANKER_PROVIDER=http
RERANKER_BASE_URL=http://127.0.0.1:8091
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATES=30
ADMIN_API_KEY=change-this-admin-key
APP_SHARED_SECRET=change-this-shared-secret
APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=internal-assistant-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ALLOWED_ORIGINS=
BOT_ENDPOINT=
CUSTOM_INCIDENTS_API_BASE_URL=
INDEXER_API_BASE_URL=
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
TEAMS_APP_ID=
EVAL_MAX_CONCURRENCY=1
